+"""Completed-stage selective negamax; frozen non-neural policy and WDL value."""
+import copy,time
+import numpy as np
+from .engine import play
+from .linear_value import Search,outcome
+
+class CompletedSearch(Search):
+ def __init__(self,agent,ms=25,width=6,replies=3,depth=2,base_width=6,base_replies=3,node_limit=None):
+  super().__init__(agent,ms,width,replies,depth)
+  if depth not in (2,4):raise ValueError('completed search depth must be 2 or 4')
+  for n in (base_width,base_replies):
+   if n is not None and (not isinstance(n,int) or n<1):raise ValueError('invalid base width')
+  self.base_width=base_width;self.base_replies=base_replies;self.node_limit=node_limit
+ def act(self,s,rng):
+  begin=time.perf_counter();deadline=begin+self.ms/1000 if self.ms else float('inf')
+  nodes=0;input_s=0.;value_s=0.;input_max=.0002;value_max=.0002;reply_count=0
+  def guard(cost=0.):
+   if time.perf_counter()+cost+.0002>=deadline:raise TimeoutError
+  def inputs(t):
+   nonlocal input_s,input_max
+   q=time.perf_counter();r=self.agent.inputs(t);dt=time.perf_counter()-q;input_s+=dt;input_max=max(input_max,dt);return r
+  x,qs,p=inputs(s)
+  if not qs:
+   self.stats.append(dict(ms=(time.perf_counter()-begin)*1000,forced_pass=True,complete=True,fallback=False,depth=0,nodes=0));return None
+  scores=x@self.agent.weights[p];baseline=qs[int(rng.choice(np.flatnonzero(scores>=scores.max()-1e-7)))].move
+  ordered=[qs[i].move for i in np.argsort(-scores,kind='stable')]
+  def roots(width):
+   r=ordered[:width] if width else ordered[:]
+   if baseline not in r:r[-1]=baseline
+   assert len(set(r))==len(r)
+   return r
+  def visit(t,d,replies):
+   nonlocal nodes,value_s,value_max,reply_count
+   guard()
+   if self.node_limit is not None and nodes>=self.node_limit:raise TimeoutError
+   nodes+=1
+   if t.done:return outcome(t,t.turn)
+   if d==0:
+    guard(value_max);q=time.perf_counter();v=self.agent.value(t);dt=time.perf_counter()-q;value_s+=dt;value_max=max(value_max,dt);return v
+   guard(input_max);a,c,k=inputs(t)
+   ids=np.argsort(-(a@self.agent.weights[k]),kind='stable') if c else []
+   moves=[c[i].move for i in (ids[:replies] if replies else ids)] if c else [None]
+   best=-float('inf')
+   for m in moves:
+    guard();child=copy.deepcopy(t);play(child,m,validate=False);reply_count+=1;best=max(best,-visit(child,d-1,replies))
+   return best
+  stages=[(self.base_width,self.base_replies,2)]
+  if (self.width,self.replies,self.depth)!=stages[0]:stages.append((self.width,self.replies,self.depth))
+  completed=[];attempts=[];move=baseline;chosen_values=[];chosen_roots=[]
+  for width,replies,depth in stages:
+   rr=roots(width);values=[];ok=False
+   try:
+    for m in rr:
+     guard();child=copy.deepcopy(s);play(child,m,validate=False);values.append(-visit(child,depth-1,replies))
+    if time.perf_counter()>deadline:raise TimeoutError
+    ok=True
+   except TimeoutError:pass
+   attempts.append(dict(depth=depth,width=width,replies=replies,roots=len(rr),completed_roots=len(values),complete=ok))
+   if not ok:break
+   # Consume a selection draw only once, after final completed stage.
+   completed.append(attempts[-1]);chosen_values=values;chosen_roots=rr
+  if completed:move=chosen_roots[int(rng.choice(np.flatnonzero(np.asarray(chosen_values)>=max(chosen_values)-1e-12)))]
+  elapsed=(time.perf_counter()-begin)*1000;last=completed[-1] if completed else {}
+  self.stats.append(dict(ms=elapsed,nodes=nodes,fallback=not completed,complete=bool(completed),depth=last.get('depth',0),root_width=last.get('width'),reply_width=last.get('replies'),root_candidates=len(chosen_roots),completed_roots=len(chosen_values),legal_candidates=len(qs),values=chosen_values,roots=[[m.piece,m.orientation,m.row,m.col] for m in chosen_roots],attempts=attempts,target_complete=len(completed)==len(stages),overshoot=self.ms>0 and elapsed>self.ms,overshoot_ms=max(0.,elapsed-self.ms) if self.ms else 0.,input_ms=input_s*1000,value_ms=value_s*1000,replies_evaluated=reply_count,baseline=[baseline.piece,baseline.orientation,baseline.row,baseline.col]))
+  return move
diff --git a/tests/test_linear_tree.py b/tests/test_linear_tree.py
new file mode 100644
index 0000000..f3cffc5
--- /dev/null
+++ b/tests/test_linear_tree.py
@@ -0,0 +1,84 @@
+import copy,random
+import numpy as np
+import pytest
+from blokus.engine import State,play,legal_moves
+from blokus.linear_value import Agent,Search,outcome
+from blokus.linear_tree import CompletedSearch
+
+def exact(s):
+ # Independent coordinate-set exhaustive solver for monomino-only endings.
+ # These tests deliberately do not use engine legal_moves, play, or score here.
+ from blokus.engine import Move,cells_of
+ assert all(b in (0,1) for b in s.remaining)
+ def solve(boards,left,last,turn,passes):
+  if passes>=2:
+   scores=[(20 if last[p]==0 else 15) if left[p]==0 else -1 for p in (0,1)]
+   d=scores[turn]-scores[1-turn];return float((d>0)-(d<0)),{None}
+  own,opp=boards[turn],boards[1-turn];moves=[]
+  if left[turn]:
+   for r in range(14):
+    for c in range(14):
+     if (r,c) in own|opp:continue
+     if any((r+dr,c+dc) in own for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))):continue
+     if (not own and (r,c)==((4,4),(9,9))[turn]) or (own and any((r+dr,c+dc) in own for dr,dc in ((1,1),(1,-1),(-1,1),(-1,-1)))):moves.append(Move(0,0,r,c))
+  if not moves:moves=[None]
+  values=[]
+  for m in moves:
+   b=[set(x) for x in boards];l=left.copy();la=last.copy();pa=passes+1
+   if m is not None:b[turn].add((m.row,m.col));l[turn]=0;la[turn]=0;pa=0
+   values.append(-solve(b,l,la,1-turn,pa)[0])
+  return max(values),{m for m,v in zip(moves,values) if v==max(values)}
+ return solve([set(cells_of(x)) for x in s.boards],s.remaining.copy(),s.last.copy(),s.turn,s.passes)
+
+def test_exact_terminal_pass_and_same_player_continuation():
+ a=Agent('old')
+ for s in [State(remaining=[1,1]),State(remaining=[1,0],last=[None,1]),State(remaining=[0,0],last=[0,1])]:
+  before=copy.deepcopy(s)
+  if not legal_moves(s):
+   b=CompletedSearch(a,ms=0,width=None,replies=None,depth=4,base_width=None,base_replies=None);assert b.act(s,random.Random(1)) is None
+   t=copy.deepcopy(s);play(t,None);assert t.turn!=s.turn
+   if not t.done:play(t,None) if not legal_moves(t) else None
+  else:
+   v,best=exact(s);b=CompletedSearch(a,ms=0,width=None,replies=None,depth=4,base_width=None,base_replies=None);m=b.act(s,random.Random(1));assert m in best and max(b.stats[-1]['values'])==v
+  assert s==before
+ s=State(remaining=[0,0],last=[0,1],passes=2);assert a.value(s)==1; s.turn=1;assert a.value(s)==-1
+
+def test_completed_stage_fallback_and_no_state_mutation():
+ s=State();a=Agent('old');before=copy.deepcopy(s)
+ base=CompletedSearch(a,ms=0);m=base.act(s,random.Random(4));n=base.stats[-1]['nodes']
+ deeper=CompletedSearch(a,ms=0,depth=4,node_limit=n);assert deeper.act(s,random.Random(4))==m
+ stat=deeper.stats[-1];assert stat['depth']==2 and not stat['target_complete'] and stat['values']==base.stats[-1]['values']
+ tiny=CompletedSearch(a,ms=.000001);assert tiny.act(s,random.Random(4))==a.act(s,random.Random(4));assert tiny.stats[-1]['fallback'] and tiny.stats[-1]['values']==[]
+ assert s==before
+
+def test_fixed_tree_matches_legacy_without_pruning():
+ s=State();a=Agent('old');rng=random.Random(123)
+ for _ in range(20):play(s,a.act(s,rng))
+ for w,r in [(6,3),(24,8)]:
+  old=Search(a,ms=0,width=w,replies=r);new=CompletedSearch(a,ms=0,width=w,replies=r,base_width=w,base_replies=r)
+  old.act(s,random.Random(0));new.act(s,random.Random(0));assert old.stats[-1]['values']==new.stats[-1]['values']
+  stat=new.stats[-1];assert stat['baseline'] in stat['roots'] and len({tuple(x) for x in stat['roots']})==len(stat['roots'])
+
+def test_greedy_near_tie_not_dropped():
+ a=Agent('old');a.weights[:]=0;s=State();b=CompletedSearch(a,ms=0,width=1,replies=1,base_width=1,base_replies=1);b.act(s,random.Random(89));assert b.stats[-1]['baseline'] in b.stats[-1]['roots']
+ with pytest.raises(ValueError):CompletedSearch(a,depth=3)
+
+def test_wide_stage_partial_results_are_discarded():
+ a=Agent('old');s=State();base=CompletedSearch(a,ms=0);m=base.act(s,random.Random(7))
+ wide=CompletedSearch(a,ms=0,width=24,replies=8,node_limit=base.stats[-1]['nodes']+10)
+ assert wide.act(s,random.Random(7))==m
+ assert wide.stats[-1]['values']==base.stats[-1]['values'] and wide.stats[-1]['root_width']==6 and not wide.stats[-1]['target_complete']
+
+def test_saved_position_deepcopy_regression():
+ from blokus.linear_train2 import state_hash
+ s=State();saved=copy.deepcopy([s.boards,s.remaining,s.last,s.turn,s.passes]);h=state_hash(s)
+ play(s,Agent('old').act(s,random.Random(4)))
+ assert state_hash(State(*saved))==h and state_hash(s)!=h
+
+def test_depth_four_matches_separate_legacy_fixed_tree():
+ s=State();a=Agent('old');rng=random.Random(409)
+ for _ in range(20):play(s,a.act(s,rng))
+ old=Search(a,ms=0,width=2,replies=2,depth=4)
+ new=CompletedSearch(a,ms=0,width=2,replies=2,depth=4,base_width=2,base_replies=2)
+ old.act(s,random.Random(2));new.act(s,random.Random(2))
+ assert new.stats[-1]['depth']==4 and new.stats[-1]['values']==old.stats[-1]['values']
